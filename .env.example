# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_web_push_certificate_public_key

# Vercel notification API (server-only — never prefix these with VITE_)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project_id"}
SUPER_ADMIN_EMAIL=your-email@example.com

# Admin Email (only this email can access admin features)
VITE_ADMIN_EMAIL=your-email@example.com
